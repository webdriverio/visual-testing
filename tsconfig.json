{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "removeComments": false,
    "strictFunctionTypes": false,
    "experimentalDecorators": true,
    "lib": ["dom", "es2024"],
  },

  "exclude": [
    "node_modules",
    "tests",
    "build",
    "coverage",
    "/*.js",
    "/*.cjs"
  ]
}

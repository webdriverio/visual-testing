{
  "name": "@wdio/ocr-service",
  "author": "Wim Selles - wswebcreation",
  "description": "A WebdriverIO service that is using Tesseract OCR for Desktop/Mobile Web and Mobile Native App tests.",
  "version": "3.0.0",
  "license": "MIT",
  "homepage": "https://webdriver.io/docs/visual-testing",
  "repository": {
    "type": "git",
    "url": "https://github.com/webdriverio/visual-testing.git"
  },
  "bin": {
    "ocr-service": "./dist/cli.js"
  },
  "keywords": [
    "webdriverio",
    "tesseract",
    "ocr",
    "image"
  ],
  "exports": "./dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "run-s clean build:*",
    "build:tsc": "tsc --project ./tsconfig.json",
    "clean": "rimraf coverage dist .tmp",
    "watch": "pnpm run build:tsc -w"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.4",
    "@wdio/globals": "^10.1.0",
    "@wdio/logger": "^10.1.0",
    "@wdio/types": "^10.0.1",
    "fuse.js": "^7.5.0",
    "jimp": "^1.6.1",
    "node-tesseract-ocr": "^2.2.1",
    "tesseract.js": "^7.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/inquirer": "~9.0.10",
    "@types/xml2js": "~0.4.14",
    "webdriverio": "^10.1.0"
  },
  "peerDependencies": {
    "webdriverio": "^10.0.0"
  }
}

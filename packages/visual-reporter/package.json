{
  "name": "@wdio/visual-reporter",
  "author": "Wim Selles - wswebcreation",
  "description": "Visual Testing HTML Report for the @wdio/visual-service module",
  "version": "0.4.15",
  "license": "MIT",
  "homepage": "https://webdriver.io/docs/visual-testing",
  "repository": {
    "type": "git",
    "url": "https://github.com/webdriverio/visual-testing.git"
  },
  "type": "module",
  "bin": {
    "wdio-visual-reporter": "./dist/cli.js"
  },
  "scripts": {
    "build": "run-s clean build:*",
    "build:report": "react-router build",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "clean": "rimraf coverage build --glob *.tsbuildinfo",
    "dev": "cross-env VISUAL_REPORT_LOCAL_DEV=true run-s build:scripts script:prepare.report && run-p watch:scripts dev:app",
    "dev:app": "react-router dev",
    "script:prepare.report": "node ./dist/prepareReportAssets.js",
    "test:lint": "oxlint -c ../../.oxlintrc.json .",
    "start": "sirv build/client --single",
    "typecheck": "tsc",
    "watch": "run-s clean watch:*",
    "watch:dev": "npm run dev",
    "watch:scripts": "npm run build:scripts --watch"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "ora": "^9.4.1",
    "sharp": "^0.35.5",
    "sirv-cli": "^3.0.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.4",
    "@react-router/node": "^7.18.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.1",
    "isbot": "^5.2.2",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router": "^7.18.4",
    "react-select": "^5.10.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^6.4.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
